# Local Ollama
DISKWISE_OLLAMA_BASE_URL=http://localhost:11434
DISKWISE_DEFAULT_TEXT_MODEL=gemma4:e2b

# Optional OpenAI-compatible cloud API
# Cloud access is disabled unless this value is explicitly set to true.
DISKWISE_CLOUD_ENABLED=false
DISKWISE_CLOUD_BASE_URL=https://example.com/v1
DISKWISE_CLOUD_API_KEY=your-api-key-here

# Optional development override. Production defaults to %LOCALAPPDATA%\DiskWise.
# DISKWISE_DATA_DIR=D:\DiskWise\data

